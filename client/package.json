{
    "name": "client",
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24.15.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck:app && vite build",
        "preview": "vite preview",
        "lint:check:file": "eslint --max-warnings 0 --no-warn-ignored",
        "lint:check:all": "eslint --max-warnings 0 .",
        "lint:fix:file": "eslint --fix --max-warnings 0 --no-warn-ignored",
        "lint:fix:all": "eslint --fix --max-warnings 0 .",
        "prettier:check:file": "prettier --check",
        "prettier:check:all": "prettier --check .",
        "prettier:fix:file": "prettier --write",
        "prettier:fix:all": "prettier --write .",
        "format:check:all": "npm run lint:check:all && npm run prettier:check:all",
        "format:fix:all": "npm run lint:fix:all && npm run prettier:fix:all",
        "check:precommit": "lint-staged",
        "quality:fix:all": "npm run lint:fix:all && npm run prettier:fix:all && npm run typecheck:app",
        "quality:fix:all:no-format": "npm run lint:fix:all && npm run typecheck:app",
        "openapi:fetch:seb-server": "node scripts/fetch-seb-server-openapi.mjs",
        "openapi:generate": "openapi-ts --file openapi-ts.config.ts",
        "openapi:refresh": "npm run openapi:fetch:seb-server && npm run openapi:generate",
        "prepare": "cd .. && husky ./client/.husky",
        "typecheck:app": "vue-tsc --noEmit",
        "typecheck:playwright": "tsc -p tests/tsconfig.json --noEmit",
        "test:unit": "vitest run",
        "test:e2e": "npx playwright test",
        "test:e2eui": "npx playwright test --ui",
        "test:e2e:headed": "npx playwright test --headed",
        "test:e2e:interactive": "npx playwright codegen http://localhost:8082",
        "test:e2e:chromium": "npx playwright test --project=chromium --headed"
    },
    "lint-staged": {
        "*.{vue,js,jsx,ts,tsx,json,md,mdx,css,scss,html,yml,yaml}": "npm run prettier:fix:file"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "@hey-api/openapi-ts": "0.99.0",
        "@mdi/font": "7.4.47",
        "@playwright/test": "1.64.1",
        "@tanstack/vue-query": "5.106.1",
        "@types/lodash": "4.17.27",
        "@types/node": "24.19.2",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/devtools-api": "8.2.1",
        "@vue/language-core": "3.3.14",
        "@vue/language-server": "3.3.14",
        "@vuepic/vue-datepicker": "14.0.0",
        "@vueuse/core": "15.0.0",
        "axios": "1.21.0",
        "chart.js": "4.6.1",
        "date-fns-tz": "3.2.0",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-vue": "10.12.0",
        "eslint-plugin-vuetify": "2.7.3",
        "globals": "17.14.0",
        "husky": "9.1.7",
        "ipaddr.js": "2.5.0",
        "jsdom": "31.0.0",
        "lint-staged": "17.6.0",
        "lodash": "4.18.1",
        "moment-timezone": "0.6.6",
        "pinia": "4.1.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "unplugin-fonts": "2.1.0",
        "vite": "8.3.6",
        "vite-plugin-vuetify": "2.1.3",
        "vitest": "5.1.0",
        "vue": "3.5.45",
        "vue-chartjs": "5.3.4",
        "vue-i18n": "11.4.18",
        "vue-router": "5.4.0",
        "vue-tsc": "3.3.14",
        "vuetify": "4.3.2",
        "zod": "4.6.7"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "overrides": {
        "js-yaml": "4.3.2",
        "minimatch": "11.0.4"
    }
}
