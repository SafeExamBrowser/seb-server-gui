SERVER_PORT=3001
SERVE_CLIENT=false

SEB_SERVER_USERNAME=guiClient
SEB_SERVER_PASSWORD=somePW
SEB_SERVER_URL=http://localhost:8080
SEB_SERVER_DEFAULT_URL=/admin-api/v1

PROCTOR_SERVER_USERNAME=spsGuiClient
PROCTOR_SERVER_PASSWORD=somePW
PROCTOR_SERVER_URL=http://localhost:8090
PROCTOR_SERVER_DEFAULT_URL=/admin-api/v1

# --- AI assistant (PoC) ---------------------------------------------------
# Master switch for the assistant panel. With false (default) the GUI is
# unchanged and all /api/assistant routes answer 404.
AI_ASSISTANT_ENABLED=false
# OpenAI-compatible endpoint, e.g. http://localhost:11434/v1 (Ollama) or
# https://api.openai.com/v1. Leave unset to force mock answers.
#AI_API_BASE_URL=http://localhost:11434/v1
#AI_API_KEY=
#AI_MODEL=qwen2.5:7b-instruct
# Deterministic canned answers without any model (used by the e2e tests).
AI_MOCK=false
