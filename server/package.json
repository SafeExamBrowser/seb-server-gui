{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "lint:check:all": "eslint --max-warnings 0 .",
    "lint:fix:all": "eslint --fix --max-warnings 0 .",
    "prettier:check:all": "prettier --check .",
    "prettier:fix:all": "prettier --write .",
    "format:check:all": "npm run lint:check:all && npm run prettier:check:all",
    "format:fix:all": "npm run lint:fix:all && npm run prettier:fix:all"
  },
  "dependencies": {
    "express": "5.3.0",
    "http-proxy-3": "2.0.2",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
